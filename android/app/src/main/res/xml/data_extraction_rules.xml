<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: keep app data (the saved agent and its token) out of cloud
     backup and device-to-device transfer. android:allowBackup="false" in
     the manifest covers older releases. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
